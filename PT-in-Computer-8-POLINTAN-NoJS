<!DOCTYPE html>
<html lang="en">

<head>
    <title>LJEP's Student Profile Portfolio</title>

    <style>
        body {
            background-color: #ff9a88;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
        }

        .container {
            width: 80%;
            margin: auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 10px #b8acac;
        }

        h1 {
            text-align: center;
            color: #ff6300;
        }

        h2 {
            color: #ff6300;
            border-bottom: 2px solid #ff6300;
            padding-bottom: 5px;
        }

        h3 {
            color: #333333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        th,
        td {
            border: 1px solid #8700ff;
            padding: 12px;
            text-align: left;
        }

        .title {
            background-color: #ff6300;
            color: #000000;
            text-align: center;
        }

        .details {
            background-color: #e5d5ff;
            color: #333333;
        }

        td {
            background-color: #f8fbff;
        }

        form {
            background-color: #e5d5ff;
            padding: 20px;
            border-radius: 10px;
        }

        label {
            font-weight: bold;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
            border: 1px solid #aaa;
            border-radius: 5px;
            box-sizing: border-box;
        }

        .gender-options {
            display: flex;
            gap: 20px;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        .gender-options label {
            font-weight: normal;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .gender-options input[type="radio"] {
            width: auto;
            margin: 0;
        }

        textarea {
            height: 100px;
        }

        button {
            background-color: #ff6300;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #ff6300;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            color: gray;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>💫 Lei - Lei's Student Profile 💫</h1>

        <p style="text-align: center;">
            Welcome to my Student Profile! Here you can learn more about me
            and enter your own information.
        </p>

        <h2>Part 1: Student Profile Card 💳</h2>

        <h3>Here is some information about me!</h3>

        <table>

            <tr>
                <th colspan="2" class="title">
                    OFFICIAL STUDENT PROFILE CARD
                </th>
            </tr>

            <tr>
                <th class="details">Student Information</th>
                <th class="details" style="text-align: center;">
                    Details
                </th>
            </tr>

            <tr>
                <td>Name</td>
                <td>Leane Polintan aka Leane / Lei / Neon</td>
            </tr>

            <tr>
                <td>Age</td>
                <td>13</td>
            </tr>

            <tr>
                <td>Gender</td>
                <td>Female</td>
            </tr>

            <tr>
                <td>Grade Level</td>
                <td>Grade 8</td>
            </tr>

            <tr>
                <td>Section</td>
                <td>St. Matthew</td>
            </tr>

            <tr>
                <td>School</td>
                <td>Canossa Academy Calamba</td>
            </tr>

            <tr>
                <td>Role</td>
                <td>SPAC President</td>
            </tr>

        </table>

        <h2>Part 2: Settings Panel ⚙️</h2>

        <h3>Here's somewhere you can put your own information!</h3>

        <form>

            <label for="name">Name:</label>

            <input
                type="text"
                id="name"
                name="name"
                placeholder="Enter your name"
            >


            <label for="age">Age:</label>

            <input
                type="number"
                id="age"
                name="age"
                placeholder="Enter your age"
                min="1"
                max="100"
            >


            <label>Gender:</label>

            <div class="gender-options">

                <label>
                    <input
                        type="radio"
                        name="gender"
                        value="Male"
                    >
                    Male
                </label>

                <label>
                    <input
                        type="radio"
                        name="gender"
                        value="Female"
                    >
                    Female
                </label>

                <label>
                    <input
                        type="radio"
                        name="gender"
                        value="Other"
                    >
                    Other
                </label>

            </div>


            <label for="grade">
                Grade Level: Ex. Grade 8
            </label>

            <input
                type="text"
                id="grade"
                name="grade"
                placeholder="Enter your grade level"
            >


            <label for="section">Section:</label>

            <input
                type="text"
                id="section"
                name="section"
                placeholder="Enter your section"
            >


            <label for="role">Role:</label>

            <select id="role" name="role">

                <option value="Student">
                    Student
                </option>

                <option value="SPAC">
                    SPAC
                </option>

                <option value="SKC">
                    SKC
                </option>

                <option value="Staff/Teaching Personel">
                    Staff/Teaching Personnel
                </option>

            </select>


            <label for="about">About Me:</label>

            <textarea
                id="about"
                name="about"
                placeholder="Tell us something about yourself..."
            ></textarea>


            <button type="submit">
                Save Profile
            </button>

        </form>

        <div class="footer">
            <p>© 2026 LJEP's Student Profile</p>
        </div>

    </div>

</body>

</html>